  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Cobalt action button for install, submit, and other primary actions.",
      "html": "<button class=\"ds-btn-primary\">Install Werkbord</button>",
      "css": ".ds-btn-primary{height:38px;padding:0 16px;border:1px solid #1C3AD6;border-radius:5px;background:#2447FF;color:#fff;font:500 14px Geist,system-ui,sans-serif;box-shadow:inset 0 1px 0 rgba(255,255,255,.26),0 3px 8px -2px rgba(36,71,255,.32);transition:transform .12s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover{transform:translateY(-1px)}.ds-btn-primary:focus-visible{outline:2px solid #2447FF;outline-offset:2px}"
    },
    {
      "name": "Document code block",
      "kind": "custom",
      "refersTo": "doc-code",
      "description": "Copyable terminal command with a quiet tray surface.",
      "html": "<div class=\"ds-code\"><div class=\"ds-code-top\">Terminal <button>Copy</button></div><code>werkbord status</code></div>",
      "css": ".ds-code{overflow:hidden;border:1px solid #DAD9D3;border-radius:8px;background:#EDEDE8;color:#0A0A0A}.ds-code-top{display:flex;justify-content:space-between;padding:8px 12px;border-bottom:1px solid #DAD9D3;font:500 11px 'Geist Mono',monospace;color:#55554F}.ds-code code{display:block;padding:18px 16px;font:12px/1.7 'Geist Mono',monospace}"
    }
  ],
  "narrative": {
    "northStar": "Quiet technical clarity",
    "overview": "Werkbord is a quiet technical surface for work that is happening locally. The visual system is compact, tactile, and information-led.",
    "keyCharacteristics": ["Neutral paper and charcoal grounds", "Cobalt action and amber attention", "Pixel geometry", "Finite restrained motion"],
    "rules": [
      { "name": "The Rare Accent Rule", "body": "Cobalt and amber should mark an action or state. Leave surrounding content neutral so the signal stays useful.", "section": "colors" },
      { "name": "The Direct Type Rule", "body": "Keep headlines short and let scale do the emphasis.", "section": "typography" }
    ],
    "dos": ["Do use cobalt and amber to explain state or action.", "Do preserve the pixel geometry and neutral surface rhythm."],
    "donts": ["Don't add hype, em dashes, or a second explanation where a direct sentence works.", "Don't use animation to hide content or make a status feel urgent."]
  }
