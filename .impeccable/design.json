      "amber": { "role": "secondary", "displayName": "Amber", "canonical": "#F2A93B", "tonalRamp": ["#5B350A", "#8B510F", "#BB741D", "#F2A93B", "#F5B961", "#F8CB87", "#FBE0B6", "#FFF2DA"] },
